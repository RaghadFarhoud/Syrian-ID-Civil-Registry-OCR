# ============================================================
#  ID Relay — نموذج الإعدادات
#  انسخ هذا الملف إلى ".env" ثم عدّل القيم حسب موقع العميل.
#  بعد التعديل شغّل:  python build_config.py
#  (يمكن استخدام متغيرات البيئة بنفس الأسماء — وهي تفوز دائماً)
# ============================================================

# ---------- [1] عنوان موقع الإدخال (الموقع الحقيقي) ----------
RELAY_TARGET_TAB_PREFIX=http://localhost:8000/demo-target

#  إذا الموقع مو مفتوح أصلاً: هل نفتحه تلقائياً؟ 1 = نعم
RELAY_OPEN_TAB_IF_MISSING=1

#  العنوان الذي يُفتح عند غياب التاب
RELAY_OPEN_URL_IF_MISSING=http://localhost:8000/demo-target

# ---------- [2] الخادم المحلي (تطبيق الاستخراج) ----------
RELAY_BASE_URL=http://localhost:8000

# ---------- [3] سلوك التعبئة ----------
#  هل نعبّي فقط بدون الضغط على أي زر حفظ/إرسال؟ 1 = نعم (موصى به)
RELAY_FILL_ONLY=1

#  إذا ما حطيت سيليكتور لحقل: هل نبحث عنه تلقائياً من تسميات عربية؟ 1 = نعم
RELAY_AUTODETECT_LABELS=1

#  هل نعبّي الحقول الظاهرة فقط؟ 1 = نعم
RELAY_FILL_WHEN_VISIBLE=1

#  هل نبحث داخل iframes أيضاً؟ 1 = نعم
RELAY_SCAN_FRAMES=1

#  هل نتجاهل الحقول الفارغة؟ 1 = نعم
RELAY_SKIP_EMPTY_VALUES=1

#  هل نملأ الحقول داخل الخطوات المخفية أيضاً (بدون فتح قائمة)؟ 1 = نعم
RELAY_SWEEP_HIDDEN=1

# ---------- [4] خريطة الحقول → عناصر نموذج الموقع ----------
#  لكل حقل عندنا: اكتب CSS selector أو اتركه فاضياً ليعتمد على الكشف التلقائي.
#  افصل أكثر من سيليكتور بفاصلة.
#  أي حقل ما بتكتبله سيليكتور وللكشف التلقائي ما لحقو = يهمل نهائياً.
FIELD_SELECTOR_first_name=
FIELD_SELECTOR_father_name=
FIELD_SELECTOR_family_name=
FIELD_SELECTOR_mother_name=
FIELD_SELECTOR_mother_family_name=
FIELD_SELECTOR_birth_date=
FIELD_SELECTOR_amanah=
FIELD_SELECTOR_registry_number=
FIELD_SELECTOR_national_number=

#  خطوات تحضيرية تُضغط قبل تعبئة حقل معيّن (مثلاً زر "إضافة بطاقة جديدة")
# FIELD_ENSURE_national_number=

#  تسميات إضافية للكشف التلقائي لكل حقل (مفصولة بفاصلة)
FIELD_LABEL_first_name=
FIELD_LABEL_father_name=
FIELD_LABEL_family_name=
FIELD_LABEL_mother_name=
FIELD_LABEL_mother_family_name=
FIELD_LABEL_birth_date=
FIELD_LABEL_amanah=
FIELD_LABEL_registry_number=
FIELD_LABEL_national_number=

# ---------- [5] تجهيز بطاقة الهوية (خطوتان ثابتتان قبل الرقم الوطني) ----------
#  نوع البطاقة يتبع نوع المستند المستخرج:
#      national_id    (بطاقة هوية) → هوية
#      civil_registry (سجل مدني)   → قيد مدني
#  الصيغة:  النوع=القيمة  مفصولة بفاصلة
FIXED_SELECTOR_card_name=mat-select[formcontrolname="cardName"]
FIXED_VALUE_BY_DOCTYPE_card_name=national_id=هوية,civil_registry=قيد مدني
#  القيمة الاحتياطية إذا كان نوع المستند غير معروف
FIXED_VALUE_card_name=هوية
FIXED_ENSURE_card_name=

#  جهة الإصدار: «نفوس» دائماً (عدّلها من FIXED_VALUE_card_issuer)
FIXED_SELECTOR_card_issuer=mat-select[formcontrolname="cardIssuer"]
FIXED_VALUE_card_issuer=نفوس
FIXED_ENSURE_card_issuer=
